{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rltree.local/design-judgment/authorial-12/world-card.schema.json",
  "title": "Authorial 12 World Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "direction_id", "thesis", "category_default_refused", "first_viewport", "structural_grammar", "signature_interaction", "salience", "commitments", "responsive_transformation", "honest_risk"],
  "properties": {
    "schema_version": {"const": "dj-authorial-12-world-card-v1"},
    "direction_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "thesis": {"type": "string", "minLength": 12, "maxLength": 240},
    "category_default_refused": {"type": "string", "minLength": 8, "maxLength": 180},
    "first_viewport": {"type": "string", "minLength": 20, "maxLength": 420},
    "structural_grammar": {"type": "string", "minLength": 12, "maxLength": 240},
    "signature_interaction": {"type": "string", "minLength": 8, "maxLength": 240},
    "salience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "supporting", "quiet"],
      "properties": {
        "primary": {"type": "string", "minLength": 4, "maxLength": 180},
        "supporting": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "minLength": 2, "maxLength": 140}},
        "quiet": {"type": "array", "maxItems": 6, "items": {"type": "string", "minLength": 2, "maxLength": 140}}
      }
    },
    "commitments": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["axis", "decision", "provenance"],
        "properties": {
          "axis": {"enum": ["composition", "typography", "color-material", "shape-depth", "motion", "imagery-data", "copy", "responsive"]},
          "decision": {"type": "string", "minLength": 5, "maxLength": 220},
          "provenance": {"enum": ["product-mechanism", "audience-scene", "platform-authority", "explicit-user-preference", "established-design-authority"]},
          "exception": {"type": ["string", "null"], "maxLength": 180}
        }
      }
    },
    "responsive_transformation": {"type": "string", "minLength": 12, "maxLength": 300},
    "honest_risk": {"type": "string", "minLength": 8, "maxLength": 240}
  }
}
