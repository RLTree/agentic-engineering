{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rltree.local/design-judgment/authorial-12/truth-spine.schema.json",
  "title": "Authorial 12 Truth Spine",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_truth", "derived_values", "identity_invariants", "required_states", "effect_boundary", "narrow_width"],
  "properties": {
    "schema_version": {"const": "dj-authorial-12-truth-spine-v1"},
    "product_truth": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/invariant"}},
    "derived_values": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/invariant"}},
    "identity_invariants": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/invariant"}},
    "required_states": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/state"}},
    "effect_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_effects", "confirmation", "truthful_receipt"],
      "properties": {
        "external_effects": {"type": "string", "minLength": 4, "maxLength": 180},
        "confirmation": {"type": "string", "minLength": 4, "maxLength": 180},
        "truthful_receipt": {"type": "string", "minLength": 4, "maxLength": 180}
      }
    },
    "narrow_width": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_css_width", "must_remain_visible", "overflow_test"],
      "properties": {
        "minimum_css_width": {"type": "integer", "minimum": 320, "maximum": 480},
        "must_remain_visible": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "minLength": 2, "maxLength": 120}},
        "overflow_test": {"type": "string", "minLength": 8, "maxLength": 180}
      }
    }
  },
  "$defs": {
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "assertion", "source", "observable_test"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
        "assertion": {"type": "string", "minLength": 5, "maxLength": 180},
        "source": {"type": "string", "minLength": 2, "maxLength": 160},
        "observable_test": {"type": "string", "minLength": 5, "maxLength": 180}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entry", "visible_result", "reachable_by"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
        "entry": {"type": "string", "minLength": 3, "maxLength": 140},
        "visible_result": {"type": "string", "minLength": 3, "maxLength": 180},
        "reachable_by": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"enum": ["pointer", "touch", "keyboard", "programmatic", "alternate-entry"]}}
      }
    }
  }
}
