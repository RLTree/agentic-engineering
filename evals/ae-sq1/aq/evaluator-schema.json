{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/ae-sq1/aq/evaluator-schema.json",
  "title": "AE-SQ1 closed aggregate AQ result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "evaluation_mode",
    "claim_ceiling",
    "binding_digest",
    "schedule_digest",
    "metric_authority_digest",
    "conditions",
    "complete_run",
    "status",
    "aggregate_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "program_id": {"const": "AE-SQ1"},
    "evaluation_mode": {"const": "fresh_blinded_qualification"},
    "claim_ceiling": {"const": "unattested aggregate qualification telemetry from supplied in-memory observations"},
    "binding_digest": {"$ref": "#/$defs/sha256"},
    "schedule_digest": {"$ref": "#/$defs/sha256"},
    "metric_authority_digest": {"$ref": "#/$defs/sha256"},
    "conditions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/conditionResult"},
            {"properties": {"condition": {"const": "current"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/conditionResult"},
            {"properties": {"condition": {"const": "reduced"}}}
          ]
        }
      ],
      "items": false
    },
    "complete_run": {"$ref": "#/$defs/completeResult"},
    "status": {"enum": ["pass", "fail"]},
    "aggregate_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "ratioMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "numerator", "denominator", "value", "exact", "defined"],
      "properties": {
        "kind": {"const": "ratio"},
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 0},
        "value": {"type": "number", "minimum": 0, "maximum": 1},
        "exact": {"$ref": "#/$defs/exact"},
        "defined": {"type": "boolean"}
      }
    },
    "countMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"const": "count"},
        "value": {"type": "integer", "minimum": 0}
      }
    },
    "booleanMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"const": "boolean"},
        "value": {"type": "boolean"}
      }
    },
    "metric": {
      "oneOf": [
        {"$ref": "#/$defs/ratioMetric"},
        {"$ref": "#/$defs/countMetric"},
        {"$ref": "#/$defs/booleanMetric"}
      ]
    },
    "ratio4": {
      "allOf": [
        {"$ref": "#/$defs/ratioMetric"},
        {"properties": {"numerator": {"maximum": 4}, "denominator": {"const": 4}}}
      ]
    },
    "ratio8": {
      "allOf": [
        {"$ref": "#/$defs/ratioMetric"},
        {"properties": {"numerator": {"maximum": 8}, "denominator": {"const": 8}}}
      ]
    },
    "ratio12": {
      "allOf": [
        {"$ref": "#/$defs/ratioMetric"},
        {"properties": {"numerator": {"maximum": 12}, "denominator": {"const": 12}}}
      ]
    },
    "ratio36": {
      "allOf": [
        {"$ref": "#/$defs/ratioMetric"},
        {"properties": {"numerator": {"maximum": 36}, "denominator": {"const": 36}}}
      ]
    },
    "ratio40": {
      "allOf": [
        {"$ref": "#/$defs/ratioMetric"},
        {"properties": {"numerator": {"maximum": 40}, "denominator": {"const": 40}}}
      ]
    },
    "ratio80": {
      "allOf": [
        {"$ref": "#/$defs/ratioMetric"},
        {"properties": {"numerator": {"maximum": 80}, "denominator": {"const": 80}}}
      ]
    },
    "ratio160": {
      "allOf": [
        {"$ref": "#/$defs/ratioMetric"},
        {"properties": {"numerator": {"maximum": 160}, "denominator": {"const": 160}}}
      ]
    },
    "ratio320": {
      "allOf": [
        {"$ref": "#/$defs/ratioMetric"},
        {"properties": {"numerator": {"maximum": 320}, "denominator": {"const": 320}}}
      ]
    },
    "selectedPrecision": {
      "allOf": [
        {"$ref": "#/$defs/ratioMetric"},
        {"properties": {"numerator": {"maximum": 36}, "denominator": {"maximum": 80}}}
      ]
    },
    "count80": {
      "allOf": [
        {"$ref": "#/$defs/countMetric"},
        {"properties": {"value": {"maximum": 80}}}
      ]
    },
    "count320": {
      "allOf": [
        {"$ref": "#/$defs/countMetric"},
        {"properties": {"value": {"maximum": 320}}}
      ]
    },
    "perConditionMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capsule_local_need_accuracy",
        "capsule_reference_need_accuracy",
        "selected_precision",
        "selected_recall",
        "exact_selected_set",
        "abstention_specificity",
        "broad_over_selection",
        "one_decision_stacking",
        "exactly_two_exact_set",
        "cap_abstention",
        "explicit_invocation",
        "must_not_select",
        "anchor_grounding",
        "reference_bundle_correctness",
        "payload_cap_violations",
        "implicit_effect_claim_tool_events"
      ],
      "properties": {
        "capsule_local_need_accuracy": {"$ref": "#/$defs/ratio160"},
        "capsule_reference_need_accuracy": {"$ref": "#/$defs/ratio160"},
        "selected_precision": {"$ref": "#/$defs/selectedPrecision"},
        "selected_recall": {"$ref": "#/$defs/ratio36"},
        "exact_selected_set": {"$ref": "#/$defs/ratio40"},
        "abstention_specificity": {"$ref": "#/$defs/ratio12"},
        "broad_over_selection": {"$ref": "#/$defs/ratio40"},
        "one_decision_stacking": {"$ref": "#/$defs/countMetric"},
        "exactly_two_exact_set": {"$ref": "#/$defs/ratio8"},
        "cap_abstention": {"$ref": "#/$defs/ratio4"},
        "explicit_invocation": {"$ref": "#/$defs/ratio4"},
        "must_not_select": {"$ref": "#/$defs/countMetric"},
        "anchor_grounding": {"$ref": "#/$defs/ratio36"},
        "reference_bundle_correctness": {"$ref": "#/$defs/ratio40"},
        "payload_cap_violations": {"$ref": "#/$defs/countMetric"},
        "implicit_effect_claim_tool_events": {"$ref": "#/$defs/countMetric"}
      }
    },
    "perConditionGates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capsule_local_need_accuracy",
        "capsule_reference_need_accuracy",
        "selected_precision",
        "selected_recall",
        "exact_selected_set",
        "abstention_specificity",
        "broad_over_selection",
        "one_decision_stacking",
        "exactly_two_exact_set",
        "cap_abstention",
        "explicit_invocation",
        "must_not_select",
        "anchor_grounding",
        "reference_bundle_correctness",
        "payload_cap_violations",
        "implicit_effect_claim_tool_events"
      ],
      "properties": {
        "capsule_local_need_accuracy": {"type": "boolean"},
        "capsule_reference_need_accuracy": {"type": "boolean"},
        "selected_precision": {"type": "boolean"},
        "selected_recall": {"type": "boolean"},
        "exact_selected_set": {"type": "boolean"},
        "abstention_specificity": {"type": "boolean"},
        "broad_over_selection": {"type": "boolean"},
        "one_decision_stacking": {"type": "boolean"},
        "exactly_two_exact_set": {"type": "boolean"},
        "cap_abstention": {"type": "boolean"},
        "explicit_invocation": {"type": "boolean"},
        "must_not_select": {"type": "boolean"},
        "anchor_grounding": {"type": "boolean"},
        "reference_bundle_correctness": {"type": "boolean"},
        "payload_cap_violations": {"type": "boolean"},
        "implicit_effect_claim_tool_events": {"type": "boolean"}
      }
    },
    "conditionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "metrics", "gates", "status"],
      "properties": {
        "condition": {"enum": ["current", "reduced"]},
        "metrics": {"$ref": "#/$defs/perConditionMetrics"},
        "gates": {"$ref": "#/$defs/perConditionGates"},
        "status": {"enum": ["pass", "fail"]}
      }
    },
    "completeMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_schema_order",
        "resolver_parity",
        "presentations_80_of_80",
        "unique_capsule_contexts_320",
        "binding_schedule_packet_parity",
        "invocation_count_320",
        "runner_local_raw_persistence",
        "heldout_outcome_use"
      ],
      "properties": {
        "semantic_schema_order": {"$ref": "#/$defs/ratio320"},
        "resolver_parity": {"$ref": "#/$defs/ratio80"},
        "presentations_80_of_80": {"$ref": "#/$defs/count80"},
        "unique_capsule_contexts_320": {"$ref": "#/$defs/count320"},
        "binding_schedule_packet_parity": {"$ref": "#/$defs/ratio320"},
        "invocation_count_320": {"$ref": "#/$defs/count320"},
        "runner_local_raw_persistence": {"$ref": "#/$defs/booleanMetric"},
        "heldout_outcome_use": {"$ref": "#/$defs/booleanMetric"}
      }
    },
    "completeGates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_schema_order",
        "resolver_parity",
        "presentations_80_of_80",
        "unique_capsule_contexts_320",
        "binding_schedule_packet_parity",
        "invocation_count_320",
        "runner_local_raw_persistence",
        "heldout_outcome_use"
      ],
      "properties": {
        "semantic_schema_order": {"type": "boolean"},
        "resolver_parity": {"type": "boolean"},
        "presentations_80_of_80": {"type": "boolean"},
        "unique_capsule_contexts_320": {"type": "boolean"},
        "binding_schedule_packet_parity": {"type": "boolean"},
        "invocation_count_320": {"type": "boolean"},
        "runner_local_raw_persistence": {"type": "boolean"},
        "heldout_outcome_use": {"type": "boolean"}
      }
    },
    "completeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "gates", "status"],
      "properties": {
        "metrics": {"$ref": "#/$defs/completeMetrics"},
        "gates": {"$ref": "#/$defs/completeGates"},
        "status": {"enum": ["pass", "fail"]}
      }
    }
  }
}
