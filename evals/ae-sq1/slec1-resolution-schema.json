{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agentic-engineering/evals/ae-sq1/slec1-resolution-schema.json",
  "title": "AE-SQ1 SLEC-1 closed durable resolution record",
  "$defs": {
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hex40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "slot": {"type": "string", "enum": ["s0", "s1", "s2", "s3"]},
    "capability": {
      "type": "string",
      "enum": [
        "cap.ae.architecture.core.v1",
        "cap.ae.architecture.focused.v1",
        "cap.ae.task-contract.core.v1",
        "cap.ae.task-contract.focused.v1",
        "cap.ae.verification.core.v1",
        "cap.ae.verification.focused.v1",
        "cap.ae.learning.core.v1",
        "cap.ae.learning.focused.v1"
      ]
    },
    "outcome": {
      "type": "object",
      "properties": {
        "slot_id": {"$ref": "#/$defs/slot"},
        "local_need": {"type": "string", "enum": ["yes", "no", "uncertain", "invalid"]},
        "reference_need": {"type": "string", "enum": ["none", "core", "focused", "uncertain", "invalid"]}
      },
      "required": ["slot_id", "local_need", "reference_need"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "record_version": {"const": "1.0"},
    "mechanism_id": {"const": "AE-SQ1-SLEC-1"},
    "condition_id": {"type": "string", "enum": ["current", "reduced"]},
    "resolution_status": {
      "type": "string",
      "enum": ["selected", "no_selection", "abstain_invalid", "abstain_uncertain", "abstain_cap"]
    },
    "selection_mode": {"type": "string", "enum": ["none", "capsule_fold", "explicit_invocation"]},
    "input_custody": {
      "type": "object",
      "properties": {
        "task_utf8_sha256": {"$ref": "#/$defs/hex64"},
        "capsule_set_sha256": {"$ref": "#/$defs/hex64"},
        "capsule_count": {"type": "integer", "minimum": 0, "maximum": 1024},
        "capsule_custody_complete": {"type": "boolean"}
      },
      "required": [
        "task_utf8_sha256",
        "capsule_set_sha256",
        "capsule_count",
        "capsule_custody_complete"
      ],
      "additionalProperties": false
    },
    "slot_outcomes": {
      "type": "array",
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/outcome"}, {"properties": {"slot_id": {"const": "s0"}}}]},
        {"allOf": [{"$ref": "#/$defs/outcome"}, {"properties": {"slot_id": {"const": "s1"}}}]},
        {"allOf": [{"$ref": "#/$defs/outcome"}, {"properties": {"slot_id": {"const": "s2"}}}]},
        {"allOf": [{"$ref": "#/$defs/outcome"}, {"properties": {"slot_id": {"const": "s3"}}}]}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "invocation_evidence": {
      "type": "object",
      "properties": {
        "recognized_count": {"type": "integer", "minimum": 0},
        "recognized_slots": {
          "type": "array",
          "items": {"$ref": "#/$defs/slot"},
          "uniqueItems": true,
          "maxItems": 4
        },
        "has_unrecognized_or_malformed": {"type": "boolean"}
      },
      "required": [
        "recognized_count",
        "recognized_slots",
        "has_unrecognized_or_malformed"
      ],
      "additionalProperties": false
    },
    "selected_slots": {
      "type": "array",
      "items": {"$ref": "#/$defs/slot"},
      "uniqueItems": true,
      "maxItems": 2
    },
    "reference_capability_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/capability"},
      "uniqueItems": true,
      "maxItems": 2
    },
    "references": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "enum": ["not_requested", "resolved", "custody_failure"]},
        "files": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "slot_id": {"$ref": "#/$defs/slot"},
              "reference_need": {"type": "string", "enum": ["core", "focused"]},
              "capability_id": {"$ref": "#/$defs/capability"},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/hex64"},
              "git_blob_sha1": {"$ref": "#/$defs/hex40"},
              "size_bytes": {"type": "integer", "minimum": 0, "maximum": 4096}
            },
            "required": [
              "slot_id",
              "reference_need",
              "capability_id",
              "path",
              "sha256",
              "git_blob_sha1",
              "size_bytes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["status", "files"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "resolved"}}, "required": ["status"]},
          "then": {"properties": {"files": {"minItems": 1}}},
          "else": {"properties": {"files": {"maxItems": 0}}}
        }
      ]
    },
    "claim_ceiling": {"const": "structural-proposal-only"}
  },
  "required": [
    "record_version",
    "mechanism_id",
    "condition_id",
    "resolution_status",
    "selection_mode",
    "input_custody",
    "slot_outcomes",
    "invocation_evidence",
    "selected_slots",
    "reference_capability_ids",
    "references",
    "claim_ceiling"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "resolution_status": {"const": "selected"},
        "selection_mode": {"const": "explicit_invocation"},
        "selected_slots": {"minItems": 1},
        "reference_capability_ids": {"maxItems": 0},
        "references": {
          "properties": {
            "status": {"const": "not_requested"},
            "files": {"maxItems": 0}
          }
        }
      }
    },
    {
      "properties": {
        "resolution_status": {"const": "selected"},
        "selection_mode": {"const": "capsule_fold"},
        "selected_slots": {"minItems": 1},
        "references": {
          "properties": {
            "status": {"enum": ["not_requested", "resolved"]}
          }
        }
      }
    },
    {
      "properties": {
        "resolution_status": {"const": "no_selection"},
        "selection_mode": {"const": "capsule_fold"},
        "selected_slots": {"maxItems": 0},
        "reference_capability_ids": {"maxItems": 0},
        "references": {
          "properties": {
            "status": {"const": "not_requested"},
            "files": {"maxItems": 0}
          }
        }
      }
    },
    {
      "properties": {
        "resolution_status": {"const": "abstain_invalid"},
        "selection_mode": {"const": "none"},
        "selected_slots": {"maxItems": 0},
        "reference_capability_ids": {"maxItems": 0},
        "references": {
          "properties": {
            "status": {"enum": ["not_requested", "custody_failure"]},
            "files": {"maxItems": 0}
          }
        }
      }
    },
    {
      "properties": {
        "resolution_status": {"const": "abstain_uncertain"},
        "selection_mode": {"const": "none"},
        "selected_slots": {"maxItems": 0},
        "reference_capability_ids": {"maxItems": 0},
        "references": {
          "properties": {
            "status": {"const": "not_requested"},
            "files": {"maxItems": 0}
          }
        }
      }
    },
    {
      "properties": {
        "resolution_status": {"const": "abstain_cap"},
        "selection_mode": {"const": "none"},
        "selected_slots": {"maxItems": 0},
        "reference_capability_ids": {"maxItems": 0},
        "references": {
          "properties": {
            "status": {"const": "not_requested"},
            "files": {"maxItems": 0}
          }
        }
      }
    }
  ]
}
