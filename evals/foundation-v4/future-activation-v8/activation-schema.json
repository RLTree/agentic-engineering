        "graph_status": {
          "enum": [
            "valid",
            "graph_uncertain",
            "graph_invalid",
            "graph_cycle"
          ]
        },
        "automatic_selection_status": {
          "enum": [
            "automatic",
            "cap_exceeded",
            "graph_uncertain",
            "graph_invalid",
            "graph_cycle"
