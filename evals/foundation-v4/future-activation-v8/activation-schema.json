    "candidate_state_row": {
      "type": "object",
      "properties": {
        "slot_id": {
          "$ref": "#/$defs/slot_id"
        },
        "state": {
          "enum": [
            "unresolved",
            "resolved_or_absent",
            "uncertain"
          ]
        }
      },
      "required": [
        "slot_id",
        "state"
      ],
      "additionalProperties": false
    },
    "pairwise_relation_row": {
      "type": "object",
      "properties": {
