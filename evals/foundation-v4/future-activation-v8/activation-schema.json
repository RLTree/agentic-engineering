  "$defs": {
    "slot_id": {
      "enum": [
        "s0",
        "s1",
        "s2",
        "s3"
      ]
    },
    "adviser_id": {
      "enum": [
        "agentic-engineering",
        "codex-task-contract",
        "verification-strategy-engineering",
        "engineering-learning-loop"
      ]
    },
    "slot_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slot_id"
      },
      "minItems": 0,
      "maxItems": 4,
      "uniqueItems": true
    },
    "adviser_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/adviser_id"
      },
      "minItems": 0,
      "maxItems": 4,
      "uniqueItems": true
