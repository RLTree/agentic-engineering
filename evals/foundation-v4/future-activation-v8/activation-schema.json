    "reference_need_row": {
      "type": "object",
      "properties": {
        "slot_id": {
          "$ref": "#/$defs/slot_id"
        },
        "need": {
          "enum": [
            "none",
            "primary",
            "secondary",
            "uncertain"
          ]
        }
      },
      "required": [
        "slot_id",
        "need"
      ],
      "additionalProperties": false
