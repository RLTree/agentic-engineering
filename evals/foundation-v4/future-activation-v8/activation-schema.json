    "case": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^AQ8-(authoring|heldout)-(0[1-9]|[12][0-9]|3[0-6])$"
        },
        "case_nonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "task_text_nfc_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_semantic_output": {
          "$ref": "#/$defs/semantic_output"
        },
        "expected_parent_derivation": {
          "$ref": "#/$defs/parent_derivation"
        }
