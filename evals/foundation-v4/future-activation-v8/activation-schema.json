            "const": "AQ8-authoring"
          }
        },
        "required": [
          "corpus_id"
        ]
      },
      "then": {
        "properties": {
          "split_nonce": {
            "const": "fcedacb4116091fe69d412a085fd40e350b8f1c7e70348dd3dd950d1752da1c2"
