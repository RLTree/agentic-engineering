                {
                  "properties": {
                    "left_slot": {
                      "const": "s1"
                    },
                    "right_slot": {
                      "const": "s2"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/pairwise_relation_row"
                },
                {
                  "properties": {
                    "left_slot": {
                      "const": "s1"
                    },
                    "right_slot": {
                      "const": "s3"
                    }
                  }
