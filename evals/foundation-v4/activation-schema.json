{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agentic-engineering/evals/foundation-v4/activation-schema.json",
  "title": "Foundation V4 fixed-four-adviser activation corpus and route observation",
  "type": "object",
  "$ref": "#/$defs/corpus",
  "$defs": {
    "adviser": {
      "type": "string",
      "enum": [
        "agentic-engineering",
        "codex-task-contract",
        "verification-strategy-engineering",
        "engineering-learning-loop"
      ]
    },
    "referenceTrigger": {
      "type": "string",
      "enum": [
        "architecture-boundary",
        "decision-contract",
        "verification-evidence",
        "learning-adoption",
        "decomposition-boundary",
        "no-change-abstention",
        "reference-isolation"
      ]
    },
    "hiddenLabels": {
      "type": "object",
      "properties": {
        "expected_advisers": {
          "type": "array",
          "items": {"$ref": "#/$defs/adviser"},
          "uniqueItems": true,
          "maxItems": 2
        },
        "must_not_select": {
          "type": "array",
          "items": {"$ref": "#/$defs/adviser"},
          "uniqueItems": true
        },
        "reference_triggers": {
          "type": "array",
          "items": {"$ref": "#/$defs/referenceTrigger"},
          "uniqueItems": true,
          "maxItems": 3
        }
      },
      "required": ["expected_advisers", "must_not_select", "reference_triggers"],
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "properties": {
        "effect_authority": {"const": false},
        "claim_authority": {"const": false}
      },
      "required": ["effect_authority", "claim_authority"],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^AQ-(A|H)-[0-9]{3}$"},
        "family_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "category": {
          "type": "string",
          "enum": ["decomposition", "task-contract", "verification", "learning", "native-sufficient", "near-neighbor", "explicit-invocation"]
        },
        "mode": {"type": "string", "enum": ["automatic", "explicit"]},
        "prompt": {"type": "string", "minLength": 24},
        "authority": {"$ref": "#/$defs/authority"},
        "condition_blind": {"const": true},
        "labels_visible_to_runner": {"const": false},
        "outcomes_visible_to_authoring": {"const": false},
        "hidden_labels": {"$ref": "#/$defs/hiddenLabels"},
        "near_neighbor_kind": {"type": ["string", "null"], "enum": ["exactly_two", "precedence", null]},
        "declared_invocation": {"type": ["string", "null"], "enum": ["agentic-engineering", "codex-task-contract", "verification-strategy-engineering", "engineering-learning-loop", null]}
      },
      "required": ["id", "family_id", "category", "mode", "prompt", "authority", "condition_blind", "labels_visible_to_runner", "outcomes_visible_to_authoring", "hidden_labels", "near_neighbor_kind", "declared_invocation"],
      "additionalProperties": false
    },
    "corpus": {
      "type": "object",
      "properties": {
        "schema_version": {"const": "1.0"},
        "corpus_id": {"type": "string", "pattern": "^foundation-v4-activation-(authoring|heldout)$"},
        "split": {"type": "string", "enum": ["authoring", "heldout"]},
        "candidate_independent": {"const": true},
        "routing_surface": {"const": "fixed-four-adviser"},
        "reference_catalog": {
          "type": "array",
          "items": {"$ref": "#/$defs/referenceTrigger"},
          "uniqueItems": true,
          "minItems": 7,
          "maxItems": 7
        },
        "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}, "minItems": 36, "maxItems": 36}
      },
      "required": ["schema_version", "corpus_id", "split", "candidate_independent", "routing_surface", "reference_catalog", "cases"],
      "additionalProperties": false
    },
    "routeObservation": {
      "type": "object",
      "properties": {
        "case_id": {"type": "string", "pattern": "^AQ-(A|H)-[0-9]{3}$"},
        "selected_advisers": {"type": "array", "items": {"$ref": "#/$defs/adviser"}, "uniqueItems": true, "maxItems": 2},
        "resolved_reference_ids": {"type": "array", "items": {"$ref": "#/$defs/referenceTrigger"}, "uniqueItems": true, "maxItems": 3},
        "context_id": {"type": "string", "minLength": 1},
        "parse_status": {"type": "string", "enum": ["parsed", "unavailable", "error"]},
        "effect_requested": {"type": "boolean"},
        "effect_granted": {"type": "boolean"},
        "claim_requested": {"type": "boolean"},
        "claim_granted": {"type": "boolean"},
        "full_schema_or_template_loaded": {"type": "boolean"}
      },
      "required": ["case_id", "selected_advisers", "resolved_reference_ids", "context_id", "parse_status", "effect_requested", "effect_granted", "claim_requested", "claim_granted", "full_schema_or_template_loaded"],
      "additionalProperties": false
    }
  }
}
