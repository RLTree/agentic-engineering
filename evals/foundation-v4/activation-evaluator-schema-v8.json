      "type": "object", "additionalProperties": false,
      "required": ["conditions", "model", "schedule", "packet", "isolation", "integrity", "authorities", "result_claims"],
      "properties": {
        "conditions": {"const": [{"id": "current", "condition_guidance_canonical_sha256": "e0c21c0ff763dc53f3ca4a6edb711d935edc041ff5d9c951dea890ddef4603af"}, {"id": "reduced", "condition_guidance_canonical_sha256": "e4085d2a637e63fb459dbdc3a64281afbbf9362501c7654ba1b95d6aff26f87b"}]},
        "model": {"const": {"id": "gpt-5.5", "reasoning_effort": "medium"}},
        "schedule": {"const": {"seed": "aq8-h4-v1", "qualification_cases": 40, "presentations": 80, "strict_alternation": true}},
        "packet": {"const": {"keys": ["instruction", "task_text", "slot_order", "pair_order", "condition_guidance", "support_legend"], "sole_condition_variance": "condition_guidance", "model_output_roots": ["candidate_states", "pairwise_relations", "reference_needs"], "candidate_state_count": 4, "pair_relation_count": 6, "reference_need_count": 4}},
        "isolation": {"const": {"fresh_empty_cwd": true, "ephemeral_context_requested": true, "sandbox": "read-only", "approval_policy": "never", "tools_enabled": false, "apps_enabled": false, "plugins_enabled": false, "mcp_enabled": false, "isolated_codex_home": true, "isolated_home_mode": "0700", "auth_source": "owner-owned-regular-nonsymlink-0600", "auth_seed": "private-copy-0600-only", "explicit_subprocess_env": true, "exact_single_probe_input": true, "temp_cleanup_required": true, "global_agents_loaded": false}},
        "integrity": {"const": {"unique_contexts_required": 80, "content_retries": 0, "canary_precompletion_infrastructure_retries_max": 1, "runner_local_raw_trajectories_persisted": false, "provider_raw_trajectory_retention_status": "unknown", "held_out_outcome_use": false}},
        "authorities": {"type": "object", "additionalProperties": false, "required": ["h4_commit", "h4_tree", "h4_sha256", "gate_commit", "gate_tree", "gate_sha256", "metric_commit", "metric_tree", "metric_sha256", "semantic_selector_schema_sha256", "runtime_selector_schema_sha256"], "properties": {"h4_commit": {"const": "d6f9e6089e6e11f158a2d3bf4af717fc026548d4"}, "h4_tree": {"const": "6b65ea1e125836c9ae684e869f1156e5750c7a0b"}, "h4_sha256": {"const": "3452f1ee7552549feac9a3f9d4d720eaae1b371177b5a4185596287ac98afd68"}, "gate_commit": {"const": "953651815e76c56f0cf8d23d9eae9ef6a480726f"}, "gate_tree": {"const": "83c5aa7ecd3930733071e509ba56d307ae49aa59"}, "gate_sha256": {"const": "d17c6de19b456100a0c930d9cbe898d123dab882fe924c92226f9962fc7784d8"}, "metric_commit": {"$ref": "#/$defs/commit"}, "metric_tree": {"$ref": "#/$defs/commit"}, "metric_sha256": {"$ref": "#/$defs/sha"}, "semantic_selector_schema_sha256": {"const": "5ef3bd8dc5a1a83a25c51d10513607c17e298086450b00181caecac0dba35af4"}, "runtime_selector_schema_sha256": {"const": "e4d58b46e39ac65e56a339e7c0d2714d536a5d517de57c2bcc34cfd5c6fe301e"}}},
        "result_claims": {"const": {"maximum_claim": "unattested deterministic AQ8 unresolved-decision graph telemetry from supplied observations", "behavioral_qualification_proven": false, "runtime_provenance_proven": false, "provider_identity_proven": false, "telemetry_attested": false, "product_behavior_proven": false, "promotion_eligible": false}}
      }
    },
    "scheduleItem": {"type": "object", "additionalProperties": false, "required": ["presentation_index", "condition", "case_id"], "properties": {"presentation_index": {"type": "integer", "minimum": 0, "maximum": 79}, "condition": {"enum": ["current", "reduced"]}, "case_id": {"type": "string", "minLength": 1, "maxLength": 128}}},
    "schedule": {"type": "object", "additionalProperties": false, "required": ["seed", "digest", "presentations"], "properties": {"seed": {"const": "aq8-h4-v1"}, "digest": {"$ref": "#/$defs/sha"}, "presentations": {"type": "array", "minItems": 80, "maxItems": 80, "items": {"$ref": "#/$defs/scheduleItem"}}}},
    "candidateState": {"type": "object", "additionalProperties": false, "required": ["slot_id", "state"], "properties": {"slot_id": {"enum": ["s0", "s1", "s2", "s3"]}, "state": {"enum": ["unresolved", "resolved_or_absent", "uncertain"]}}},
    "pairRelation": {"type": "object", "additionalProperties": false, "required": ["left_slot", "right_slot", "relation"], "properties": {"left_slot": {"enum": ["s0", "s1", "s2", "s3"]}, "right_slot": {"enum": ["s0", "s1", "s2", "s3"]}, "relation": {"enum": ["left_controls_right_downstream", "right_controls_left_downstream", "independent", "unrelated", "uncertain"]}}},
    "referenceNeed": {"type": "object", "additionalProperties": false, "required": ["slot_id", "need"], "properties": {"slot_id": {"enum": ["s0", "s1", "s2", "s3"]}, "need": {"enum": ["none", "primary", "secondary", "uncertain"]}}},
    "semanticOutput": {"type": "object", "additionalProperties": false, "required": ["candidate_states", "pairwise_relations", "reference_needs"], "properties": {"candidate_states": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/candidateState"}}, "pairwise_relations": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/pairRelation"}}, "reference_needs": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/referenceNeed"}}}},
    "request": {"type": "object", "additionalProperties": false, "required": ["owner_adviser_id", "trigger_id"], "properties": {"owner_adviser_id": {"$ref": "#/$defs/atom"}, "trigger_id": {"$ref": "#/$defs/atom"}}},
    "referenceResolution": {"type": "object", "additionalProperties": false, "required": ["status", "resolved_count", "canonical_payload_id_tuple"], "properties": {"status": {"enum": ["resolved", "unresolved", "cap_exceeded"]}, "resolved_count": {"type": "integer", "minimum": 0}, "canonical_payload_id_tuple": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/atom"}}}},
    "parentDerivation": {"type": "object", "additionalProperties": false, "required": ["graph_status", "automatic_selection_status", "selection_status", "root_slots", "selected_slots", "selected_adviser_ids", "complement_adviser_ids", "reference_requests", "reference_uncertain_slots", "reference_resolution"], "properties": {"graph_status": {"enum": ["valid", "graph_uncertain", "graph_invalid", "graph_cycle"]}, "automatic_selection_status": {"enum": ["automatic", "cap_exceeded", "graph_uncertain", "graph_invalid", "graph_cycle"]}, "selection_status": {"enum": ["automatic", "exact", "ambiguous", "unrecognized", "cap_exceeded", "graph_uncertain", "graph_invalid", "graph_cycle"]}, "root_slots": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"enum": ["s0", "s1", "s2", "s3"]}}, "selected_slots": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"enum": ["s0", "s1", "s2", "s3"]}}, "selected_adviser_ids": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/atom"}}, "complement_adviser_ids": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/atom"}}, "reference_requests": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/request"}}, "reference_uncertain_slots": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"enum": ["s0", "s1", "s2", "s3"]}}, "reference_resolution": {"$ref": "#/$defs/referenceResolution"}}},
    "events": {"type": "object", "additionalProperties": false, "required": ["effect_requested", "effect_granted", "claim_requested", "claim_granted", "tool_requested", "tool_granted"], "properties": {"effect_requested": {"type": "boolean"}, "effect_granted": {"type": "boolean"}, "claim_requested": {"type": "boolean"}, "claim_granted": {"type": "boolean"}, "tool_requested": {"type": "boolean"}, "tool_granted": {"type": "boolean"}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["case_id", "presentation_index", "context_id", "terminal_completed", "case_sha256", "task_sha256", "packet_sha256", "condition_sha256", "execution_sha256", "runner_sha256", "parse_status", "semantic_output", "parent_derivation", "events"], "properties": {"case_id": {"type": "string", "minLength": 1, "maxLength": 128}, "presentation_index": {"type": "integer", "minimum": 0, "maximum": 79}, "context_id": {"type": "string", "minLength": 1, "maxLength": 128}, "terminal_completed": {"type": "boolean"}, "case_sha256": {"$ref": "#/$defs/sha"}, "task_sha256": {"$ref": "#/$defs/sha"}, "packet_sha256": {"$ref": "#/$defs/sha"}, "condition_sha256": {"$ref": "#/$defs/sha"}, "execution_sha256": {"$ref": "#/$defs/sha"}, "runner_sha256": {"$ref": "#/$defs/sha"}, "parse_status": {"enum": ["parsed", "malformed"]}, "semantic_output": {"oneOf": [{"$ref": "#/$defs/semanticOutput"}, {"type": "null"}]}, "parent_derivation": {"oneOf": [{"$ref": "#/$defs/parentDerivation"}, {"type": "null"}]}, "events": {"$ref": "#/$defs/events"}}, "allOf": [{"if": {"properties": {"parse_status": {"const": "parsed"}}, "required": ["parse_status"]}, "then": {"properties": {"semantic_output": {"$ref": "#/$defs/semanticOutput"}, "parent_derivation": {"$ref": "#/$defs/parentDerivation"}}}}, {"if": {"properties": {"parse_status": {"const": "malformed"}}, "required": ["parse_status"]}, "then": {"properties": {"semantic_output": {"type": "null"}, "parent_derivation": {"type": "null"}}}}]},
    "condition": {"type": "object", "additionalProperties": false, "required": ["id", "digest", "observations"], "properties": {"id": {"enum": ["current", "reduced"]}, "digest": {"$ref": "#/$defs/sha"}, "observations": {"type": "array", "minItems": 0, "maxItems": 80, "items": {"$ref": "#/$defs/observation"}}}},
    "completeRunAssertions": {"type": "object", "additionalProperties": false, "required": ["runner_local_raw_persistence", "runner_local_raw_persistence_corroborated", "held_out_outcome_use", "held_out_outcome_use_corroborated"], "properties": {"runner_local_raw_persistence": {"type": "boolean"}, "runner_local_raw_persistence_corroborated": {"type": "boolean"}, "held_out_outcome_use": {"type": "boolean"}, "held_out_outcome_use_corroborated": {"type": "boolean"}}}
  }
