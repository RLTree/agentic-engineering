        "protocol": {"$ref": "#/$defs/identity"}, "reference_policy": {"$ref": "#/$defs/identity"}, "corpus": {"$ref": "#/$defs/identity"}, "candidate": {"$ref": "#/$defs/identity"}, "runner": {"$ref": "#/$defs/identity"}, "evaluator": {"$ref": "#/$defs/identity"}, "validator": {"$ref": "#/$defs/identity"},
        "cli": {"$ref": "#/$defs/idDigest"}, "model": {"$ref": "#/$defs/idDigest"}, "reasoning": {"$ref": "#/$defs/idDigest"}, "tools": {"$ref": "#/$defs/digestOnly"}, "host": {"$ref": "#/$defs/digestOnly"},
        "schedule": {"type": "object", "additionalProperties": false, "required": ["seed", "digest"], "properties": {"seed": {"$ref": "#/$defs/atom"}, "digest": {"$ref": "#/$defs/sha"}}}
      }
    },
