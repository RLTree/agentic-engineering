    "schedule": {"$ref": "#/$defs/schedule"},
    "complete_run_assertions": {"$ref": "#/$defs/completeRunAssertions"},
    "conditions": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"allOf": [{"$ref": "#/$defs/condition"}, {"properties": {"id": {"const": "current"}}}]}, {"allOf": [{"$ref": "#/$defs/condition"}, {"properties": {"id": {"const": "reduced"}}}]}], "items": false}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "atom": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "identity": {"type": "object", "additionalProperties": false, "required": ["commit", "tree", "digest"], "properties": {"commit": {"$ref": "#/$defs/commit"}, "tree": {"$ref": "#/$defs/commit"}, "digest": {"$ref": "#/$defs/sha"}}},
    "idDigest": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"$ref": "#/$defs/atom"}, "digest": {"$ref": "#/$defs/sha"}}},
    "digestOnly": {"type": "object", "additionalProperties": false, "required": ["digest"], "properties": {"digest": {"$ref": "#/$defs/sha"}}},
