{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agentic-engineering/evals/foundation-v4/activation-evaluator-schema-v8.json",
  "title": "AQ8 closed in-memory unresolved-decision graph observation envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_mode", "provenance_mode", "binding", "execution_contract", "schedule", "complete_run_assertions", "conditions"],
  "properties": {
    "schema_version": {"const": "8.0"},
    "evaluation_mode": {"const": "qualification"},
