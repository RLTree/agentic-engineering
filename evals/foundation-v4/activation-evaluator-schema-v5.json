    "candidate":{"type":"object","additionalProperties":false,"required":["commit","tree","input_sha256"],"properties":{"commit":{"$ref":"#/$defs/commit"},"tree":{"$ref":"#/$defs/commit"},"input_sha256":{"$ref":"#/$defs/sha"}}},
    "corpus":{"type":"object","additionalProperties":false,"required":["source_commit","source_tree","activation_schema_sha256","authoring_sha256","heldout_sha256","validator_sha256"],"properties":{"source_commit":{"$ref":"#/$defs/commit"},"source_tree":{"$ref":"#/$defs/commit"},"activation_schema_sha256":{"$ref":"#/$defs/sha"},"authoring_sha256":{"$ref":"#/$defs/sha"},"heldout_sha256":{"$ref":"#/$defs/sha"},"validator_sha256":{"$ref":"#/$defs/sha"}}},
