  "properties":{"schema_version":{"const":"5.0"},"evaluation_mode":{"const":"qualification"},"provenance_mode":{"enum":["synthetic_test","live_runner"]},"corpus":{"$ref":"#/$defs/corpus"},"reduced_candidate":{"$ref":"#/$defs/candidate"},"execution_contract":{"$ref":"#/$defs/execution"},"conditions":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/condition"}}},
  "$defs":{
