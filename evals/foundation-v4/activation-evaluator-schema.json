{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.local/agentic-engineering/evals/foundation-v4/activation-evaluator-schema.json",
  "title":"AQ evaluator-owned aggregate input",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","evaluation_mode","provenance_mode","corpus","reduced_candidate","execution_contract","conditions"],
  "properties":{
    "schema_version":{"const":"2.0"},"evaluation_mode":{"const":"qualification"},
    "provenance_mode":{"enum":["synthetic_test","live_runner"]},
    "corpus":{"$ref":"#/$defs/corpus"},"reduced_candidate":{"$ref":"#/$defs/candidate"},
    "execution_contract":{"$ref":"#/$defs/execution"},
    "conditions":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/condition"}}
  },
  "$defs":{
    "sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "adviser":{"type":"string","enum":["agentic-engineering","codex-task-contract","verification-strategy-engineering","engineering-learning-loop"]},
    "payload":{"type":"object","additionalProperties":false,"required":["payload_id","owner_adviser_id","source_path","sha256"],"properties":{"payload_id":{"type":"string","minLength":1},"owner_adviser_id":{"$ref":"#/$defs/adviser"},"source_path":{"type":"string","pattern":"^plugins/"},"sha256":{"$ref":"#/$defs/sha"}}},
    "payloadResolution":{"type":"object","additionalProperties":false,"required":["status","resolved_count"],"properties":{"status":{"enum":["resolved","cap_exceeded"]},"resolved_count":{"type":"integer","minimum":0}},"oneOf":[{"properties":{"status":{"const":"resolved"},"resolved_count":{"maximum":3}}},{"properties":{"status":{"const":"cap_exceeded"},"resolved_count":{"minimum":4}}}]},
    "candidate":{"type":"object","additionalProperties":false,"required":["commit","tree","input_sha256"],"properties":{"commit":{"$ref":"#/$defs/commit"},"tree":{"$ref":"#/$defs/commit"},"input_sha256":{"$ref":"#/$defs/sha"}}},
    "corpus":{"type":"object","additionalProperties":false,"required":["source_commit","source_tree","activation_schema_sha256","authoring_sha256","heldout_sha256"],"properties":{"source_commit":{"const":"25de0cb1fe86a802768de9bf64659206d69650d0"},"source_tree":{"const":"e5faff4b1a5ba678a7df1727b5bda3b3d0afe00a"},"activation_schema_sha256":{"$ref":"#/$defs/sha"},"authoring_sha256":{"$ref":"#/$defs/sha"},"heldout_sha256":{"$ref":"#/$defs/sha"}}},
    "execution":{"type":"object","additionalProperties":false,"required":["model","reasoning","cli_path","cli_version","cli_sha256","tools_sha256","host_surface_sha256","runner_path","runner_protocol_sha256","schedule_seed","schedule_sha256","evaluator_schema_sha256","zero_write","raw_trajectories_persisted","condition_parity_sha256"],"properties":{"model":{"const":"gpt-5.5"},"reasoning":{"const":"medium"},"cli_path":{"type":"string","minLength":1},"cli_version":{"type":"string","minLength":1},"cli_sha256":{"$ref":"#/$defs/sha"},"tools_sha256":{"$ref":"#/$defs/sha"},"host_surface_sha256":{"$ref":"#/$defs/sha"},"runner_path":{"const":"scripts/run_activation_trials.py"},"runner_protocol_sha256":{"$ref":"#/$defs/sha"},"schedule_seed":{"type":"string","pattern":".*\\S.*"},"schedule_sha256":{"$ref":"#/$defs/sha"},"evaluator_schema_sha256":{"$ref":"#/$defs/sha"},"zero_write":{"const":true},"raw_trajectories_persisted":{"const":false},"condition_parity_sha256":{"$ref":"#/$defs/sha"}}},
    "observation":{"type":"object","additionalProperties":false,"required":["case_id","presentation_index","context_id","corpus_prompt_sha256","task_sha256","candidate_input_sha256","selector_catalog_sha256","selector_packet_sha256","execution_contract_sha256","runner_protocol_sha256","parse_status","selected_advisers","payload_resolution","resolved_payloads","effect_requested","effect_granted","claim_requested","claim_granted","tool_requested","tool_granted","full_schema_or_template_loaded"],"properties":{"case_id":{"type":"string","pattern":"^AQ2-(A|H)-[0-9]{3}$"},"presentation_index":{"type":"integer","minimum":0,"maximum":79},"context_id":{"type":"string","minLength":1},"corpus_prompt_sha256":{"$ref":"#/$defs/sha"},"task_sha256":{"$ref":"#/$defs/sha"},"candidate_input_sha256":{"$ref":"#/$defs/sha"},"selector_catalog_sha256":{"$ref":"#/$defs/sha"},"selector_packet_sha256":{"$ref":"#/$defs/sha"},"execution_contract_sha256":{"$ref":"#/$defs/sha"},"runner_protocol_sha256":{"$ref":"#/$defs/sha"},"parse_status":{"const":"parsed"},"selected_advisers":{"type":"array","uniqueItems":true,"maxItems":2,"items":{"$ref":"#/$defs/adviser"}},"payload_resolution":{"$ref":"#/$defs/payloadResolution"},"resolved_payloads":{"type":"array","uniqueItems":true,"maxItems":3,"items":{"$ref":"#/$defs/payload"}},"effect_requested":{"type":"boolean"},"effect_granted":{"type":"boolean"},"claim_requested":{"type":"boolean"},"claim_granted":{"type":"boolean"},"tool_requested":{"type":"boolean"},"tool_granted":{"type":"boolean"},"full_schema_or_template_loaded":{"type":"boolean"}}},
    "condition":{"type":"object","additionalProperties":false,"required":["id","candidate","adviser_universe","observations"],"properties":{"id":{"enum":["current","reduced"]},"candidate":{"$ref":"#/$defs/candidate"},"adviser_universe":{"const":["agentic-engineering","codex-task-contract","verification-strategy-engineering","engineering-learning-loop"]},"observations":{"type":"array","minItems":40,"maxItems":40,"items":{"$ref":"#/$defs/observation"}}}}
  }
}
