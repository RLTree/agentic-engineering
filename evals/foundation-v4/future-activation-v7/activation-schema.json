    "payload": { "type": "object", "properties": { "owner_adviser_id": { "$ref": "#/$defs/adviser_id" }, "payload_id": { "type": "string", "pattern": "^aq-[a-z0-9-]+$" }, "sha256": { "$ref": "#/$defs/sha256" } }, "required": ["owner_adviser_id", "payload_id", "sha256"], "additionalProperties": false },
