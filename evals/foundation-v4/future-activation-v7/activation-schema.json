          "then": { "properties": { "exactly_two": { "const": true }, "family_atom": { "type": "null" } }, "required": ["exactly_two", "family_atom"] },
          "else": { "properties": { "exactly_two": { "const": false } }, "required": ["exactly_two"] }
        }
