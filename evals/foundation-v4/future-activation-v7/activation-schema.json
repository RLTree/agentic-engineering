          "else": { "properties": { "case_family": { "const": "exact-explicit" }, "family_atom": { "$ref": "#/$defs/atom_id" }, "exactly_two": { "const": false }, "packet": { "properties": { "task_text": { "pattern": "(?<![A-Za-z0-9_-])\\$(?:agentic-engineering|codex-task-contract|verification-strategy-engineering|engineering-learning-loop)(?![A-Za-z0-9_-])" } }, "required": ["task_text"] }, "grading": { "properties": { "expected_selection_status": { "const": "exact" }, "expected_selection_constraint": { "properties": { "parse_status": { "const": "exact" }, "selected_atom": { "$ref": "#/$defs/atom_id" }, "qualified_tokens": { "minItems": 1, "maxItems": 1 }, "invocation_like_tokens": { "minItems": 1, "maxItems": 1 } }, "required": ["parse_status", "selected_atom", "qualified_tokens", "invocation_like_tokens"] } }, "required": ["expected_selection_status", "expected_selection_constraint"] } } } },
        {
