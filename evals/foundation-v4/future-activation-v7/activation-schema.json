      "properties": { "case_id": { "type": "string", "pattern": "^AQ7-[AH]-(?:00[1-9]|0[12][0-9]|03[0-6])$" }, "case_kind": { "enum": ["automatic", "explicit"] }, "case_family": { "enum": ["single-owner", "native-no-advice", "exactly-two", "exclusion-or-uncertainty-near-neighbor", "exact-explicit"] }, "family_atom": { "anyOf": [{ "$ref": "#/$defs/atom_id" }, { "type": "null" }] }, "near_neighbor_kind": { "enum": ["exclusion", "uncertainty", null] }, "exactly_two": { "type": "boolean" }, "nonce_sha256": { "$ref": "#/$defs/sha256" }, "prompt_sha256": { "$ref": "#/$defs/sha256" }, "packet": { "$ref": "#/$defs/packet" }, "grading": { "$ref": "#/$defs/grading" } },
