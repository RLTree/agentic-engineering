{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agentic-engineering/evals/foundation-v4/activation-evaluator-schema-v7.json",
  "title": "AQ7 closed, in-memory decision-certificate observation envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_mode", "provenance_mode", "binding", "execution_contract", "schedule", "conditions"],
  "properties": {
    "schema_version": {"const": "7.0"},
    "evaluation_mode": {"const": "qualification"},
    "provenance_mode": {"enum": ["synthetic", "live_runner"]},
    "binding": {"$ref": "#/$defs/binding"},
    "execution_contract": {"$ref": "#/$defs/execution"},
    "schedule": {"$ref": "#/$defs/schedule"},
    "conditions": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/condition"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "atom": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "identity": {"type": "object", "additionalProperties": false, "required": ["commit", "tree", "digest"], "properties": {"commit": {"$ref": "#/$defs/commit"}, "tree": {"$ref": "#/$defs/commit"}, "digest": {"$ref": "#/$defs/sha"}}},
    "idDigest": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"$ref": "#/$defs/atom"}, "digest": {"$ref": "#/$defs/sha"}}},
    "digestOnly": {"type": "object", "additionalProperties": false, "required": ["digest"], "properties": {"digest": {"$ref": "#/$defs/sha"}}},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "reference_policy", "corpus", "candidate", "runner", "evaluator", "validator", "cli", "model", "reasoning", "tools", "host", "schedule"],
      "properties": {
        "protocol": {"$ref": "#/$defs/identity"}, "reference_policy": {"$ref": "#/$defs/identity"}, "corpus": {"$ref": "#/$defs/identity"}, "candidate": {"$ref": "#/$defs/identity"}, "runner": {"$ref": "#/$defs/identity"}, "evaluator": {"$ref": "#/$defs/identity"}, "validator": {"$ref": "#/$defs/identity"},
        "cli": {"$ref": "#/$defs/idDigest"}, "model": {"$ref": "#/$defs/idDigest"}, "reasoning": {"$ref": "#/$defs/idDigest"}, "tools": {"$ref": "#/$defs/digestOnly"}, "host": {"$ref": "#/$defs/digestOnly"},
        "schedule": {"type": "object", "additionalProperties": false, "required": ["seed", "digest"], "properties": {"seed": {"$ref": "#/$defs/atom"}, "digest": {"$ref": "#/$defs/sha"}}}
      }
    },
    "execution": {"type": "object", "additionalProperties": false, "required": ["conditions", "model", "schedule", "packet", "isolation", "integrity", "gates", "result_claims"], "properties": {"conditions": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["id", "condition_guidance_canonical_sha256"], "properties": {"id": {"enum": ["current", "reduced"]}, "condition_guidance_canonical_sha256": {"$ref": "#/$defs/sha"}}}}, "model": {"type": "object", "additionalProperties": false, "required": ["id", "reasoning_effort"], "properties": {"id": {"const": "gpt-5.5"}, "reasoning_effort": {"const": "medium"}}}, "schedule": {"type": "object", "additionalProperties": false, "required": ["seed", "qualification_cases", "presentations", "strict_alternation"], "properties": {"seed": {"const": "aq7-h3-ci1-v1"}, "qualification_cases": {"const": 40}, "presentations": {"const": 80}, "strict_alternation": {"const": true}}}, "packet": {"type": "object", "additionalProperties": false, "required": ["keys", "sole_condition_variance", "model_output_root", "fact_count"], "properties": {"keys": {"const": ["instruction", "task_text", "predicate_order", "condition_guidance"]}, "sole_condition_variance": {"const": "condition_guidance"}, "model_output_root": {"const": "predicate_facts"}, "fact_count": {"const": 12}}}, "isolation": {"type": "object", "additionalProperties": false, "required": ["fresh_empty_cwd", "ephemeral_context_requested", "sandbox", "approval_policy", "tools_enabled", "apps_enabled", "plugins_enabled", "mcp_enabled"], "properties": {"fresh_empty_cwd": {"const": true}, "ephemeral_context_requested": {"const": true}, "sandbox": {"const": "read-only"}, "approval_policy": {"const": "never"}, "tools_enabled": {"const": false}, "apps_enabled": {"const": false}, "plugins_enabled": {"const": false}, "mcp_enabled": {"const": false}}}, "integrity": {"type": "object", "additionalProperties": false, "required": ["unique_contexts_required", "content_retries", "canary_precompletion_infrastructure_retries_max", "runner_local_raw_trajectories_persisted", "provider_raw_trajectory_retention_status"], "properties": {"unique_contexts_required": {"const": 80}, "content_retries": {"const": 0}, "canary_precompletion_infrastructure_retries_max": {"const": 1}, "runner_local_raw_trajectories_persisted": {"const": false}, "provider_raw_trajectory_retention_status": {"const": "unknown"}}}, "gates": {"type": "object", "additionalProperties": false, "required": ["automatic_precision_min", "automatic_recall_min", "native_abstention_specificity_min", "broad_router_overselection_max", "one_decision_stacking_max", "exactly_two_exact_set_min", "must_not_select_violations_max", "explicit_exact_set_min", "selector_invalid_max", "resolver_mismatch_max", "payload_cap_violations_max", "reference_load_correct_min", "authority_tool_violations_max"], "properties": {"automatic_precision_min": {"const": "0.95"}, "automatic_recall_min": {"const": "0.90"}, "native_abstention_specificity_min": {"const": "0.95"}, "broad_router_overselection_max": {"const": "0.05"}, "one_decision_stacking_max": {"const": 0}, "exactly_two_exact_set_min": {"const": "1.00"}, "must_not_select_violations_max": {"const": 0}, "explicit_exact_set_min": {"const": "1.00"}, "selector_invalid_max": {"const": 0}, "resolver_mismatch_max": {"const": 0}, "payload_cap_violations_max": {"const": 0}, "reference_load_correct_min": {"const": "1.00"}, "authority_tool_violations_max": {"const": 0}}}, "result_claims": {"type": "object", "additionalProperties": false, "required": ["maximum_claim", "runtime_provenance_proven", "provider_identity_proven", "telemetry_attested", "product_behavior_proven", "promotion_eligible"], "properties": {"maximum_claim": {"const": "unattested deterministic AQ7 decision-certificate telemetry from supplied observations"}, "runtime_provenance_proven": {"const": false}, "provider_identity_proven": {"const": false}, "telemetry_attested": {"const": false}, "product_behavior_proven": {"const": false}, "promotion_eligible": {"const": false}}}}},
    "scheduleItem": {"type": "object", "additionalProperties": false, "required": ["presentation_index", "condition", "case_id"], "properties": {"presentation_index": {"type": "integer", "minimum": 0, "maximum": 79}, "condition": {"enum": ["current", "reduced"]}, "case_id": {"type": "string", "minLength": 1, "maxLength": 128}}},
    "schedule": {"type": "object", "additionalProperties": false, "required": ["seed", "digest", "presentations"], "properties": {"seed": {"$ref": "#/$defs/atom"}, "digest": {"$ref": "#/$defs/sha"}, "presentations": {"type": "array", "minItems": 80, "maxItems": 80, "items": {"$ref": "#/$defs/scheduleItem"}}}},
    "fact": {"type": "object", "additionalProperties": false, "required": ["predicate_id", "state"], "properties": {"predicate_id": {"$ref": "#/$defs/atom"}, "state": {"enum": ["present", "absent", "uncertain"]}}},
    "factOutput": {"type": "object", "additionalProperties": false, "required": ["predicate_facts"], "properties": {"predicate_facts": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/fact"}}}},
    "payload": {"type": "object", "additionalProperties": false, "required": ["owner_adviser_id", "payload_id", "sha256"], "properties": {"owner_adviser_id": {"$ref": "#/$defs/atom"}, "payload_id": {"$ref": "#/$defs/atom"}, "sha256": {"$ref": "#/$defs/sha"}}},
    "request": {"type": "object", "additionalProperties": false, "required": ["owner_adviser_id", "trigger_id"], "properties": {"owner_adviser_id": {"$ref": "#/$defs/atom"}, "trigger_id": {"$ref": "#/$defs/atom"}}},
    "payloadResolution": {"type": "object", "additionalProperties": false, "required": ["status", "resolved_count", "payloads"], "properties": {"status": {"enum": ["resolved", "cap_exceeded", "unresolved"]}, "resolved_count": {"type": "integer", "minimum": 0}, "payloads": {"type": "array", "uniqueItems": true, "maxItems": 3, "items": {"$ref": "#/$defs/payload"}}}, "oneOf": [{"properties": {"status": {"const": "resolved"}, "resolved_count": {"maximum": 3}}, "allOf": [{"properties": {"payloads": {"maxItems": 3}}}]}, {"properties": {"status": {"const": "unresolved"}, "resolved_count": {"maximum": 3}, "payloads": {"maxItems": 0}}}, {"properties": {"status": {"const": "cap_exceeded"}, "resolved_count": {"minimum": 4}, "payloads": {"maxItems": 0}}}]},
    "events": {"type": "object", "additionalProperties": false, "required": ["effect_requested", "effect_granted", "claim_requested", "claim_granted", "tool_requested", "tool_granted", "full_schema_or_template_loaded"], "properties": {"effect_requested": {"type": "boolean"}, "effect_granted": {"type": "boolean"}, "claim_requested": {"type": "boolean"}, "claim_granted": {"type": "boolean"}, "tool_requested": {"type": "boolean"}, "tool_granted": {"type": "boolean"}, "full_schema_or_template_loaded": {"type": "boolean"}}},
    "resolution": {"type": "object", "additionalProperties": false, "required": ["selection_status", "eligible_atoms", "selected_atoms", "mapped_advisers", "selection_constraint", "reference_requests", "payload_resolution"], "properties": {"selection_status": {"enum": ["automatic", "exact", "ambiguous", "unrecognized", "cap_exceeded"]}, "eligible_atoms": {"type": "array", "uniqueItems": true, "maxItems": 4, "items": {"$ref": "#/$defs/atom"}}, "selected_atoms": {"type": "array", "uniqueItems": true, "maxItems": 2, "items": {"$ref": "#/$defs/atom"}}, "mapped_advisers": {"type": "array", "uniqueItems": true, "maxItems": 2, "items": {"$ref": "#/$defs/atom"}}, "selection_constraint": {"type": ["object", "null"]}, "reference_requests": {"type": "array", "uniqueItems": true, "maxItems": 2, "items": {"$ref": "#/$defs/request"}}, "payload_resolution": {"$ref": "#/$defs/payloadResolution"}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["case_id", "presentation_index", "context_id", "case_sha256", "task_sha256", "packet_sha256", "condition_sha256", "execution_sha256", "runner_sha256", "parse_status", "fact_output", "parent_resolution", "events"], "properties": {"case_id": {"type": "string", "minLength": 1, "maxLength": 128}, "presentation_index": {"type": "integer", "minimum": 0, "maximum": 79}, "context_id": {"type": "string", "minLength": 1, "maxLength": 128}, "case_sha256": {"$ref": "#/$defs/sha"}, "task_sha256": {"$ref": "#/$defs/sha"}, "packet_sha256": {"$ref": "#/$defs/sha"}, "condition_sha256": {"$ref": "#/$defs/sha"}, "execution_sha256": {"$ref": "#/$defs/sha"}, "runner_sha256": {"$ref": "#/$defs/sha"}, "parse_status": {"enum": ["parsed", "malformed"]}, "fact_output": {"oneOf": [{"$ref": "#/$defs/factOutput"}, {"type": "null"}]}, "parent_resolution": {"oneOf": [{"$ref": "#/$defs/resolution"}, {"type": "null"}]}, "events": {"$ref": "#/$defs/events"}}, "allOf": [{"if": {"properties": {"parse_status": {"const": "parsed"}}}, "then": {"properties": {"fact_output": {"$ref": "#/$defs/factOutput"}, "parent_resolution": {"$ref": "#/$defs/resolution"}}}}, {"if": {"properties": {"parse_status": {"const": "malformed"}}}, "then": {"properties": {"fact_output": {"type": "null"}, "parent_resolution": {"type": "null"}}}}]},
    "condition": {"type": "object", "additionalProperties": false, "required": ["id", "digest", "observations"], "properties": {"id": {"enum": ["current", "reduced"]}, "digest": {"$ref": "#/$defs/sha"}, "observations": {"type": "array", "minItems": 40, "maxItems": 40, "items": {"$ref": "#/$defs/observation"}}}}
  }
}
