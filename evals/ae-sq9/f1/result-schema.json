  "required": ["aggregate_digest", "candidate_id", "program_id", "schema_version", "status"],
  "properties": {
    "aggregate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_id": {"const": "AE-SQ9-SLEC-9"},
