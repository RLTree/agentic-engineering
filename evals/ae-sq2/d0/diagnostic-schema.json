{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agentic-engineering/evals/ae-sq2/d0/diagnostic-schema.json",
  "title": "AE-SQ2 four-call handshake diagnostic record",
  "type": "object",
  "properties": {
    "diagnostic_id": {"const": "AE-SQ2-D0-2026-08-12-01"},
    "mode": {"enum": ["dry_run", "live"]},
    "status": {"enum": ["ready", "completed"]},
    "claim_ceiling": {"const": "four-call-synthetic-handshake-diagnostic-only"},
    "authority_sha256": {"$ref": "#/$defs/sha256"},
    "diagnostic_schema_sha256": {"$ref": "#/$defs/sha256"},
    "input_schema": {
      "type": "object",
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["path", "size_bytes", "sha256"],
      "additionalProperties": false
    },
    "cli": {
      "type": "object",
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "version": {"const": "codex-cli 0.147.0"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["path", "version", "sha256"],
      "additionalProperties": false
    },
    "model": {"const": "gpt-5.5"},
    "reasoning_effort": {"const": "medium"},
    "calls_started": {"type": "integer", "minimum": 0, "maximum": 4},
    "calls_completed": {"type": "integer", "minimum": 0, "maximum": 4},
    "classification_counts": {"$ref": "#/$defs/classification_counts"},
    "usage": {"$ref": "#/$defs/usage"},
    "calls": {
      "type": "array",
      "maxItems": 4,
      "items": {"$ref": "#/$defs/call"}
    },
    "aggregate_sha256": {"$ref": "#/$defs/sha256"},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "required": [
    "diagnostic_id",
    "mode",
    "status",
    "claim_ceiling",
    "authority_sha256",
    "diagnostic_schema_sha256",
    "input_schema",
    "cli",
    "model",
    "reasoning_effort",
    "calls_started",
    "calls_completed",
    "classification_counts",
    "usage",
    "calls",
    "aggregate_sha256",
    "record_sha256"
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "classification": {
      "enum": [
        "transport_spawn",
        "process_exit",
        "signal_exit",
        "timeout",
        "empty_stdout",
        "invalid_jsonl",
        "unknown_event",
        "provider_request_rejected",
        "schema_unsupported",
        "missing_completed_message",
        "schema_invalid",
        "semantic_invalid",
        "valid_completed",
        "other_fail_closed"
      ]
    },
    "classification_counts": {
      "type": "object",
      "properties": {
        "transport_spawn": {"type": "integer", "minimum": 0, "maximum": 4},
        "process_exit": {"type": "integer", "minimum": 0, "maximum": 4},
        "signal_exit": {"type": "integer", "minimum": 0, "maximum": 4},
        "timeout": {"type": "integer", "minimum": 0, "maximum": 4},
        "empty_stdout": {"type": "integer", "minimum": 0, "maximum": 4},
        "invalid_jsonl": {"type": "integer", "minimum": 0, "maximum": 4},
        "unknown_event": {"type": "integer", "minimum": 0, "maximum": 4},
        "provider_request_rejected": {"type": "integer", "minimum": 0, "maximum": 4},
        "schema_unsupported": {"type": "integer", "minimum": 0, "maximum": 4},
        "missing_completed_message": {"type": "integer", "minimum": 0, "maximum": 4},
        "schema_invalid": {"type": "integer", "minimum": 0, "maximum": 4},
        "semantic_invalid": {"type": "integer", "minimum": 0, "maximum": 4},
        "valid_completed": {"type": "integer", "minimum": 0, "maximum": 4},
        "other_fail_closed": {"type": "integer", "minimum": 0, "maximum": 4}
      },
      "required": [
        "transport_spawn",
        "process_exit",
        "signal_exit",
        "timeout",
        "empty_stdout",
        "invalid_jsonl",
        "unknown_event",
        "provider_request_rejected",
        "schema_unsupported",
        "missing_completed_message",
        "schema_invalid",
        "semantic_invalid",
        "valid_completed",
        "other_fail_closed"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      },
      "required": ["input_tokens", "cached_input_tokens", "output_tokens", "total_tokens"],
      "additionalProperties": false
    },
    "event_counts": {
      "type": "object",
      "properties": {
        "thread_started": {"type": "integer", "minimum": 0},
        "turn_started": {"type": "integer", "minimum": 0},
        "item_completed": {"type": "integer", "minimum": 0},
        "turn_completed": {"type": "integer", "minimum": 0},
        "turn_failed": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0}
      },
      "required": [
        "thread_started",
        "turn_started",
        "item_completed",
        "turn_completed",
        "turn_failed",
        "error",
        "unknown"
      ],
      "additionalProperties": false
    },
    "call": {
      "type": "object",
      "properties": {
        "probe_id": {"enum": ["p0", "p1", "p2", "p3"]},
        "classification": {"$ref": "#/$defs/classification"},
        "exit_code": {"type": ["integer", "null"], "minimum": 0},
        "signal": {"type": ["integer", "null"], "minimum": 1},
        "request_bytes": {"type": "integer", "minimum": 1},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "stdout_bytes": {"type": "integer", "minimum": 0},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_bytes": {"type": "integer", "minimum": 0},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "completed_message_bytes": {"type": "integer", "minimum": 0},
        "completed_message_sha256": {"$ref": "#/$defs/sha256"},
        "event_type_counts": {"$ref": "#/$defs/event_counts"},
        "usage_observed": {"type": "boolean"},
        "usage": {"$ref": "#/$defs/usage"},
        "error_class": {
          "enum": [
            "none",
            "invalid_json_schema",
            "invalid_request",
            "authentication",
            "authorization",
            "rate_limit",
            "network",
            "server",
            "other"
          ]
        }
      },
      "required": [
        "probe_id",
        "classification",
        "exit_code",
        "signal",
        "request_bytes",
        "request_sha256",
        "stdout_bytes",
        "stdout_sha256",
        "stderr_bytes",
        "stderr_sha256",
        "completed_message_bytes",
        "completed_message_sha256",
        "event_type_counts",
        "usage_observed",
        "usage",
        "error_class"
      ],
      "additionalProperties": false
    }
  }
}
