{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agentic-engineering/review-verdict.schema.json",
  "title": "Review Verdict",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "verdict_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_digest": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "configuration": {
      "type": "string",
      "minLength": 1
    },
    "independent": {
      "type": "boolean"
    },
    "evidence_inspected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "pointer": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "pointer"
        ],
        "additionalProperties": false
      }
    },
    "requirements_checked": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "suggested_action": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "severity",
          "claim",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "unverifiable_claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "verdict": {
      "enum": [
        "pass",
        "pass_with_findings",
        "reject",
        "blocked"
      ]
    },
    "rerun_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "verdict_id",
    "candidate_digest",
    "reviewed_scope",
    "reviewer",
    "independent",
    "evidence_inspected",
    "requirements_checked",
    "findings",
    "verdict",
    "claim_ceiling"
  ],
  "additionalProperties": false
}
