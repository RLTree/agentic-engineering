{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Tool Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "purpose",
    "input_schema",
    "output_schema",
    "side_effect_class",
    "capabilities",
    "timeout_ms",
    "idempotency",
    "approval_class",
    "errors"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 20
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "side_effect_class": {
      "enum": [
        "none",
        "local_reversible",
        "external_reversible",
        "irreversible"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1
    },
    "idempotency": {
      "enum": [
        "not_applicable",
        "caller_key",
        "server_key",
        "reconcile_required"
      ]
    },
    "approval_class": {
      "enum": [
        "none",
        "batch",
        "per_action",
        "two_person",
        "prohibited"
      ]
    },
    "data_classification": {
      "type": "string"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "repair": {
            "type": "string"
          },
          "effect_status": {
            "type": "string"
          }
        }
      }
    }
  }
}
