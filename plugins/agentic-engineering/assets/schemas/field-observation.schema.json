{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic/field-observation.schema.json",
  "title": "Agentic Field Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "observed_at",
    "operating_envelope_version",
    "cohort",
    "versions",
    "task",
    "outcome",
    "trajectory",
    "effects",
    "human_work",
    "evidence_quality",
    "privacy",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "operating_envelope_version": {
      "type": "string",
      "minLength": 1
    },
    "cohort": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "versions": {
      "$ref": "#/$defs/versions"
    },
    "task": {
      "$ref": "#/$defs/task"
    },
    "outcome": {
      "$ref": "#/$defs/outcome"
    },
    "trajectory": {
      "$ref": "#/$defs/trajectory"
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "human_work": {
      "$ref": "#/$defs/human_work"
    },
    "incident_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_quality": {
      "$ref": "#/$defs/evidence_quality"
    },
    "privacy": {
      "$ref": "#/$defs/privacy"
    },
    "mechanism_hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_change_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "new",
        "triaged",
        "investigating",
        "change_planned",
        "verifying",
        "closed",
        "no_change"
      ]
    },
    "revisit_trigger": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment",
        "model",
        "harness",
        "telemetry_schema"
      ],
      "properties": {
        "deployment": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "harness": {
          "type": "string"
        },
        "toolset": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "telemetry_schema": {
          "type": "string"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_class",
        "risk_class",
        "representativeness_cell"
      ],
      "properties": {
        "task_class": {
          "type": "string"
        },
        "risk_class": {
          "enum": [
            "low",
            "moderate",
            "high",
            "critical"
          ]
        },
        "representativeness_cell": {
          "type": "string"
        },
        "data_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "environment": {
          "type": [
            "string",
            "null"
          ]
        },
        "locale": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "verified",
        "summary"
      ],
      "properties": {
        "class": {
          "enum": [
            "success",
            "partial",
            "failure",
            "abandoned",
            "denied",
            "unknown"
          ]
        },
        "verified": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        },
        "measurements": {
          "type": "object"
        },
        "oracle_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "trajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "actions",
        "retries",
        "recovery_class"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "actions": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "recovery_class": {
          "enum": [
            "none",
            "retry",
            "repair",
            "replan",
            "reconcile",
            "compensate",
            "escalate",
            "failed"
          ]
        },
        "trace_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_id",
        "effect_class",
        "status"
      ],
      "properties": {
        "effect_id": {
          "type": "string"
        },
        "effect_class": {
          "type": "string"
        },
        "status": {
          "enum": [
            "prepared",
            "dispatched",
            "confirmed",
            "ambiguous",
            "reconciled",
            "compensated",
            "failed",
            "denied"
          ]
        },
        "authorization_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "human_work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intervention_class",
        "review_duration_ms"
      ],
      "properties": {
        "intervention_class": {
          "enum": [
            "none",
            "approval",
            "edit",
            "override",
            "escalation",
            "cancel",
            "recovery",
            "abandonment"
          ]
        },
        "review_duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "edit_distance": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strength",
        "trace_complete",
        "outcome_join_complete",
        "limitations"
      ],
      "properties": {
        "strength": {
          "enum": [
            "anecdotal",
            "synthetic",
            "replay",
            "observational",
            "controlled_field",
            "causal",
            "longitudinal"
          ]
        },
        "trace_complete": {
          "type": "boolean"
        },
        "outcome_join_complete": {
          "type": "boolean"
        },
        "assignment_valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_classification",
        "raw_content_collected",
        "retention_class"
      ],
      "properties": {
        "data_classification": {
          "type": "string"
        },
        "raw_content_collected": {
          "type": "boolean"
        },
        "retention_class": {
          "type": "string"
        },
        "consent_or_authority_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "redaction_policy_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
