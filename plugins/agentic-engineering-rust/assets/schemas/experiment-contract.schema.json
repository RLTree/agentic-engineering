{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic/experiment-contract.schema.json",
  "title": "Product Experiment Decision Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "status",
    "decision",
    "hypothesis",
    "estimand",
    "population",
    "operating_envelope_version",
    "variants",
    "assignment",
    "exposure",
    "metrics",
    "ramp",
    "validity",
    "analysis",
    "decision_rules",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "ramping",
        "running",
        "held",
        "stopped",
        "analyzed",
        "closed"
      ]
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "estimand": {
      "type": "string",
      "minLength": 1
    },
    "population": {
      "type": "string",
      "minLength": 1
    },
    "operating_envelope_version": {
      "type": "string",
      "minLength": 1
    },
    "variants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "assignment": {
      "$ref": "#/$defs/assignment"
    },
    "exposure": {
      "$ref": "#/$defs/exposure"
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "ramp": {
      "$ref": "#/$defs/ramp"
    },
    "validity": {
      "$ref": "#/$defs/validity"
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "decision_rules": {
      "$ref": "#/$defs/decision_rules"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "$defs": {
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "artifact_versions": {
          "type": "object"
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "method",
        "ratio",
        "interference_policy"
      ],
      "properties": {
        "unit": {
          "type": "string"
        },
        "method": {
          "enum": [
            "individual_randomized",
            "cluster_randomized",
            "switchback",
            "stepped_wedge",
            "quasi_experimental",
            "observational"
          ]
        },
        "ratio": {
          "type": "object"
        },
        "strata": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interference_policy": {
          "type": "string"
        }
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligibility",
        "event",
        "analysis_population"
      ],
      "properties": {
        "eligibility": {
          "type": "string"
        },
        "event": {
          "type": "string"
        },
        "analysis_population": {
          "enum": [
            "intention_to_treat",
            "as_treated",
            "per_protocol",
            "observational"
          ]
        },
        "contamination_check": {
          "type": "string"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_outcome",
        "diagnostic",
        "guardrail",
        "data_quality"
      ],
      "properties": {
        "primary_outcome": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "diagnostic": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "guardrail": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "data_quality": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ramp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "holdout",
        "kill_criteria"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exposure",
              "minimum_observation",
              "gate"
            ],
            "properties": {
              "exposure": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minimum_observation": {
                "type": "string"
              },
              "gate": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "holdout": {
          "type": "string"
        },
        "kill_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_ratio",
        "event_quality",
        "peeking",
        "multiple_testing",
        "attrition",
        "carryover"
      ],
      "properties": {
        "sample_ratio": {
          "type": "string"
        },
        "event_quality": {
          "type": "string"
        },
        "peeking": {
          "type": "string"
        },
        "multiple_testing": {
          "type": "string"
        },
        "attrition": {
          "type": "string"
        },
        "carryover": {
          "type": "string"
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "horizon",
        "material_effect",
        "segments",
        "qualitative_and_trace_review"
      ],
      "properties": {
        "horizon": {
          "type": "string"
        },
        "sample_or_stopping_rule": {
          "type": "string"
        },
        "material_effect": {
          "type": "string"
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "qualitative_and_trace_review": {
          "type": "string"
        },
        "sensitivity": {
          "type": "string"
        }
      }
    },
    "decision_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "win",
        "neutral",
        "loss",
        "mixed",
        "invalid"
      ],
      "properties": {
        "win": {
          "type": "string"
        },
        "neutral": {
          "type": "string"
        },
        "loss": {
          "type": "string"
        },
        "mixed": {
          "type": "string"
        },
        "invalid": {
          "type": "string"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "approvers",
        "stop_authority"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "approvers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "stop_authority": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
