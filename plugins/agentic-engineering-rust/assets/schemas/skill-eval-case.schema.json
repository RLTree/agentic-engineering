{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agentic-engineering/skill-evaluation-case.schema.json",
  "title": "Skill Evaluation Case",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "skill": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "invocation_class": {
      "enum": [
        "explicit",
        "implicit",
        "contextual",
        "negative",
        "overlap",
        "missing_access",
        "small",
        "consequential",
        "no_change",
        "adversarial_proxy"
      ]
    },
    "should_trigger": {
      "type": "boolean"
    },
    "baseline_version": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "visible",
        "held_out",
        "mutation",
        "spec_evolution"
      ]
    },
    "expected_behavior": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "forbidden_behavior": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "efficiency_budget": {
      "type": "object",
      "properties": {
        "max_commands": {
          "type": "integer",
          "minimum": 0
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1
        },
        "max_repair_attempts": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "max_commands",
        "max_turns",
        "max_repair_attempts"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "skill",
    "prompt",
    "invocation_class",
    "should_trigger",
    "baseline_version",
    "split",
    "expected_behavior",
    "forbidden_behavior",
    "efficiency_budget"
  ],
  "additionalProperties": false
}
