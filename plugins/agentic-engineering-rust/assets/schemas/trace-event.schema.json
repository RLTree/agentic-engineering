{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Trace Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timestamp",
    "run_id",
    "trace_id",
    "span_id",
    "event_type",
    "actor",
    "state_version",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "trace_id": {
      "type": "string"
    },
    "span_id": {
      "type": "string"
    },
    "parent_span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_type": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "state_version": {
      "type": "integer",
      "minimum": 0
    },
    "data_classification": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
