{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agentic-engineering/task-evidence-packet.schema.json",
  "title": "Task Evidence Packet",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "goal_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_digest": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "lease_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "model_configuration": {
      "type": "string",
      "minLength": 1
    },
    "context_digest": {
      "type": "string",
      "minLength": 1
    },
    "ownership": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "semantic_authority": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "forbidden_surfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "root_owned_interfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "paths",
        "semantic_authority",
        "forbidden_surfaces"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "settled_decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "budget": {
      "type": "object",
      "properties": {
        "turns": {
          "type": "integer",
          "minimum": 1
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "repair_attempts": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "turns",
        "tool_calls",
        "repair_attempts"
      ],
      "additionalProperties": false
    },
    "deadline": {
      "type": "string",
      "minLength": 1
    },
    "cancellation_lineage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "required_verification": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "issued",
        "running",
        "complete",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "changed_surfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "pointer": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "pointer"
        ],
        "additionalProperties": false
      }
    },
    "concerns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "packet_id",
    "goal_id",
    "candidate_digest",
    "plan_id",
    "task_id",
    "lease_id",
    "worker_id",
    "context_digest",
    "ownership",
    "outcome",
    "permissions",
    "budget",
    "required_verification",
    "status"
  ],
  "additionalProperties": false
}
