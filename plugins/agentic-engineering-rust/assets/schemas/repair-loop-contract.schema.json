{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agentic-engineering/repair-loop-contract.schema.json",
  "title": "Repair Loop Contract",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate": {
      "type": "string",
      "minLength": 1
    },
    "validator": {
      "type": "string",
      "minLength": 1
    },
    "attempt_budget": {
      "type": "integer",
      "minimum": 1
    },
    "time_budget": {
      "type": "string",
      "minLength": 1
    },
    "tool_call_budget": {
      "type": "integer",
      "minimum": 0
    },
    "severe_stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "ambiguous_effect_stop": {
      "type": "boolean"
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "mechanism_class": {
            "type": "string",
            "minLength": 1
          },
          "changed_variable": {
            "type": "string",
            "minLength": 1
          },
          "failure_location": {
            "type": "string",
            "minLength": 1
          },
          "observed_value": {
            "type": "string",
            "minLength": 1
          },
          "admissible_alternatives": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evidence_gained": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "result": {
            "enum": [
              "improved",
              "unchanged",
              "regressed",
              "blocked",
              "passed"
            ]
          }
        },
        "required": [
          "attempt",
          "hypothesis",
          "mechanism_class",
          "changed_variable",
          "failure_location",
          "observed_value",
          "result"
        ],
        "additionalProperties": false
      }
    },
    "circuit_decision": {
      "enum": [
        "continue",
        "change_hypothesis",
        "change_feedback",
        "change_tool_or_oracle",
        "reduce_scope",
        "redesign_architecture",
        "request_human_decision",
        "revert",
        "stop"
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "candidate",
    "validator",
    "attempt_budget",
    "ambiguous_effect_stop",
    "attempts",
    "circuit_decision"
  ],
  "additionalProperties": false
}
