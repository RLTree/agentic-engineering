{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic/operating-envelope.schema.json",
  "title": "Agentic Operating Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "version",
    "status",
    "owner",
    "approved_by",
    "valid_from",
    "users",
    "tasks",
    "data",
    "models",
    "tools",
    "environments",
    "effects",
    "budgets",
    "exclusions",
    "autonomy_level",
    "promotion",
    "demotion"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "envelope_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "suspended",
        "expired",
        "retired"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "approved_by": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "users": {
      "$ref": "#/$defs/scope"
    },
    "tasks": {
      "$ref": "#/$defs/scope"
    },
    "data": {
      "$ref": "#/$defs/scope"
    },
    "models": {
      "$ref": "#/$defs/scope"
    },
    "tools": {
      "$ref": "#/$defs/scope"
    },
    "environments": {
      "$ref": "#/$defs/scope"
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/effect_policy"
      }
    },
    "budgets": {
      "$ref": "#/$defs/budgets"
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exclusion"
      }
    },
    "autonomy_level": {
      "enum": [
        "replay",
        "observe_only",
        "shadow",
        "recommendation",
        "approval_gated",
        "bounded_autonomy",
        "broader_autonomy"
      ]
    },
    "promotion": {
      "$ref": "#/$defs/gate"
    },
    "demotion": {
      "$ref": "#/$defs/gate"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "revisit_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "limits"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "effect_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_class",
        "allowed",
        "approval",
        "idempotency",
        "reconciliation"
      ],
      "properties": {
        "effect_class": {
          "type": "string"
        },
        "allowed": {
          "type": "boolean"
        },
        "approval": {
          "enum": [
            "none",
            "sampled",
            "per_action",
            "two_person",
            "prohibited"
          ]
        },
        "max_value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "idempotency": {
          "enum": [
            "not_applicable",
            "required",
            "provider_key",
            "caller_key"
          ]
        },
        "reconciliation": {
          "enum": [
            "not_applicable",
            "required",
            "manual",
            "automatic"
          ]
        },
        "rollback_or_compensation": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_users",
        "max_runs",
        "max_effects",
        "max_cost",
        "max_duration_seconds"
      ],
      "properties": {
        "max_users": {
          "type": "integer",
          "minimum": 0
        },
        "max_runs": {
          "type": "integer",
          "minimum": 0
        },
        "max_effects": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost": {
          "type": "number",
          "minimum": 0
        },
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "max_ambiguous_effects": {
          "type": "integer",
          "minimum": 0
        },
        "max_severe_failures": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "detector",
        "response",
        "owner"
      ],
      "properties": {
        "condition": {
          "type": "string"
        },
        "detector": {
          "type": "string"
        },
        "response": {
          "enum": [
            "deny",
            "degrade",
            "request_approval",
            "stop",
            "escalate"
          ]
        },
        "owner": {
          "type": "string"
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria",
        "authority"
      ],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "authority": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
