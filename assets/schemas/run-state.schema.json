{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic/run-state.schema.json",
  "title": "Agentic Run State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "objective",
    "topology",
    "budgets",
    "state_version",
    "acceptance"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "waiting",
        "blocked",
        "verifying",
        "compensating",
        "succeeded",
        "failed",
        "cancelled",
        "escalated"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "topology": {
      "enum": [
        "direct",
        "workflow",
        "router",
        "fan_out_fan_in",
        "evaluator_optimizer",
        "bounded_loop",
        "graph",
        "durable_workflow",
        "multi_agent"
      ]
    },
    "current_node": {
      "type": [
        "string",
        "null"
      ]
    },
    "state_version": {
      "type": "integer",
      "minimum": 0
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iterations_left": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls_left": {
          "type": "integer",
          "minimum": 0
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "cost_left": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "iterations_left",
        "tool_calls_left"
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion_id",
          "status"
        ],
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "passed",
              "failed",
              "not_executed"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "failure": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
