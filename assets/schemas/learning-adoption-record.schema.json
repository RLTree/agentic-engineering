{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agentic-engineering/learning-adoption-record.schema.json",
  "title": "Learning Adoption Record",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "adopted",
        "held",
        "narrowed",
        "rejected",
        "superseded",
        "retired"
      ]
    },
    "observation": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "operating_envelope": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "enum": [
        "isolated",
        "recurring",
        "cross_context",
        "causal",
        "unresolved"
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "interpretations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "counterevidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "responsible_layer": {
      "enum": [
        "specification",
        "context",
        "tool",
        "harness",
        "loop",
        "graph",
        "runtime",
        "repository",
        "software",
        "product",
        "lifecycle",
        "human_boundary"
      ]
    },
    "mechanism_hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "recurrence": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "minLength": 1
    },
    "intervention_burden": {
      "type": "string",
      "minLength": 1
    },
    "existing_overlap": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "proposed_intervention": {
      "type": "string",
      "minLength": 1
    },
    "rejected_alternatives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "baseline": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "visible": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "held_out": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "negative_controls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "mutations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "spec_evolution": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "measures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "baseline",
        "visible",
        "held_out",
        "negative_controls",
        "measures"
      ],
      "additionalProperties": false
    },
    "results": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "decision": {
      "enum": [
        "adopt",
        "hold",
        "narrow",
        "reject",
        "supersede",
        "retire"
      ]
    },
    "review_date": {
      "type": "string",
      "minLength": 1
    },
    "expiry_or_invalidation": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "authority_handoff": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "version",
    "owner",
    "status",
    "observation",
    "provenance",
    "operating_envelope",
    "evidence_class",
    "facts",
    "interpretations",
    "hypotheses",
    "counterevidence",
    "responsible_layer",
    "mechanism_hypothesis",
    "proposed_intervention",
    "evaluation",
    "decision",
    "review_date",
    "expiry_or_invalidation",
    "rollback",
    "authority_handoff"
  ],
  "additionalProperties": false
}
