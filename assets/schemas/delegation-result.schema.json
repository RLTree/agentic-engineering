{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delegated Work Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_package_id",
    "status",
    "summary",
    "artifacts",
    "evidence",
    "assumptions",
    "residual_risks"
  ],
  "properties": {
    "work_package_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "summary": {
      "type": "string"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "integration_recommendation": {
      "type": "string"
    }
  }
}
